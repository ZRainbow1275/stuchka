# Stučka secrets template.
# Copy this file to `secrets.toml` (same directory) and fill in your own key.
# `secrets.toml` is gitignored and MUST NEVER be committed.

[siliconflow]
# SiliconFlow (硅基流动) OpenAI-compatible gateway. Bring your own API key.
base_url = "https://api.siliconflow.cn/v1"
api_key = "sk-REPLACE_WITH_YOUR_OWN_SILICONFLOW_KEY"
primary_model = "deepseek-ai/DeepSeek-V3"
secondary_model = "Qwen/Qwen2.5-7B-Instruct"

[network]
# Loopback + the AI gateway host must bypass any system proxy.
no_proxy = "127.0.0.1,localhost,api.siliconflow.cn"
